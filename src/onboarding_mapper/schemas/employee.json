{
  "name": "employee",
  "version": "1",
  "description": "Core employee record for an HRIS people import: identity, contact, employment, org and pay.",
  "fields": [
    {"name": "employee_id", "type": "id", "required": true, "unique": true, "concept": "employee.id",
     "description": "The customer's own identifier for the employee."},
    {"name": "first_name", "type": "name", "required": true, "concept": "person.given_name",
     "description": "Given name."},
    {"name": "last_name", "type": "name", "required": true, "concept": "person.family_name",
     "description": "Family name."},
    {"name": "work_email", "type": "email", "required": true, "unique": true, "concept": "contact.work_email",
     "description": "Company email address; the login identity in most HRIS tools."},
    {"name": "personal_email", "type": "email", "concept": "contact.personal_email",
     "description": "Private email address."},
    {"name": "phone", "type": "phone", "concept": "contact.phone",
     "description": "Phone number, E.164 when a country code can be established."},
    {"name": "date_of_birth", "type": "date", "concept": "person.birth_date", "min_age_years": 14, "max_age_years": 100,
     "description": "Date of birth, ISO 8601."},
    {"name": "start_date", "type": "date", "required": true, "concept": "employment.start_date", "max_future_days": 366,
     "description": "First day of employment, ISO 8601."},
    {"name": "end_date", "type": "date", "concept": "employment.end_date",
     "description": "Last day of employment, ISO 8601. Empty for current employees."},
    {"name": "employment_status", "type": "enum", "concept": "employment.status",
     "values": ["active", "on_leave", "terminated"], "description": "Current employment status."},
    {"name": "employment_type", "type": "enum", "concept": "employment.type",
     "values": ["full_time", "part_time", "contractor", "intern"], "description": "Kind of engagement."},
    {"name": "job_title", "type": "string", "concept": "job.title", "description": "Job title."},
    {"name": "department", "type": "string", "concept": "org.department", "description": "Department or team."},
    {"name": "manager_id", "type": "ref", "ref": "employee_id", "concept": "org.manager",
     "description": "employee_id of the direct manager. Resolved from an ID, a work email or a full name."},
    {"name": "location", "type": "string", "concept": "org.location", "description": "Office or city."},
    {"name": "country", "type": "country", "concept": "org.country",
     "description": "Country of work, ISO 3166-1 alpha-2."},
    {"name": "salary_amount", "type": "decimal", "concept": "pay.amount", "min_exclusive": 0, "places": 2,
     "description": "Base pay amount in salary_currency per pay_frequency."},
    {"name": "salary_currency", "type": "currency", "concept": "pay.currency",
     "description": "ISO 4217 currency code."},
    {"name": "pay_frequency", "type": "enum", "concept": "pay.frequency",
     "values": ["annual", "monthly", "hourly"], "description": "Period the salary amount refers to."},
    {"name": "fte", "type": "ratio", "concept": "employment.fte",
     "description": "Full-time equivalent between 0 and 1. Percentages are converted."}
  ],
  "rules": [
    {"id": "END_BEFORE_START", "type": "date_order", "earlier": "start_date", "later": "end_date",
     "severity": "error", "message": "end_date is before start_date"},
    {"id": "HIRED_UNDER_14", "type": "min_gap_years", "earlier": "date_of_birth", "later": "start_date", "years": 14,
     "severity": "error", "message": "start_date is less than 14 years after date_of_birth"},
    {"id": "TERMINATED_WITHOUT_END_DATE", "type": "required_when", "field": "end_date",
     "when": {"employment_status": "terminated"}, "severity": "warning",
     "message": "status is terminated but end_date is empty"},
    {"id": "SALARY_WITHOUT_CURRENCY", "type": "required_with", "field": "salary_currency", "with": "salary_amount",
     "severity": "warning", "message": "salary_amount has no salary_currency"}
  ]
}
